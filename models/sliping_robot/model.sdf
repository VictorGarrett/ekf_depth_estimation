<?xml version="1.0"?>
<sdf version="1.8">
  <model name="sliping_robot">
    <static>false</static>
    <pose>0 0 0 0 0 0</pose>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>120</odom_publish_frequency>
      <odom_topic>/ground_truth/odometry</odom_topic>
    </plugin>

    <link name="base_link">
      <selfCollide>false</selfCollide>
      <pose>0 0 0.18 0 0 0</pose>
      <inertial>
        <mass>10.0</mass>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.8 0.4 0.2</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>100</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.8 0.4 0.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0.5 1 1</ambient>
          <diffuse>0 0.5 1 1</diffuse>
        </material>
      </visual>
      <visual name="camera_imu_visual">
        <pose>0.4 0 0.1 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 0 1</ambient>
          <diffuse>1 1 0 1</diffuse>
        </material>
      </visual>

      <sensor name="camera_sensor" type="camera">
        <pose>0.4 0 0.1 0 0 0</pose>
        <camera>
          <horizontal_fov>1.0472</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>20.0</update_rate>
        <topic>camera/image_raw</topic>
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
          <render_engine>ogre2</render_engine>
        </plugin>
      </sensor>
    </link>

    <link name="front_left_wheel">
      <pose>0.15 0.2 0.05 -1.5708 0 0</pose>
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.0006583</ixx>
          <iyy>0.0006583</iyy>
          <izz>0.01125</izz>
        </inertia>
      </inertial>

      <collision name="fl_collision">
        <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
        <surface>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
          </bounce>
          <friction><ode><mu1>1.5</mu1><mu2>1.5</mu2></ode></friction>
          <contact>
            <ode>
              <kp>1e7</kp>
              <kd>100</kd>
              <max_vel>0.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="fl_visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="front_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit effort="1000" velocity="1000" />
        <dynamics>
          <damping>0.01</damping>
          <friction>0.0000001</friction>
        </dynamics>
      </axis>
    </joint>

    <plugin name="front_left_motor_plugin" filename="libDCMotorPlugin.so">
      <joint_name>front_left_joint</joint_name>
      <resistance>1.0</resistance>
      <torque_constant>0.02</torque_constant>
      <back_emf_constant>0.02</back_emf_constant>
      <gear_ratio>10.0</gear_ratio>
      <voltage_topic>/front_left_motor/voltage</voltage_topic>
      <encoder_topic>/front_left_motor/encoder</encoder_topic>
    </plugin>

    <link name="front_right_wheel">
      <pose>0.15 -0.2 0.05 -1.5708 0 0</pose>
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.0006583</ixx>
          <iyy>0.0006583</iyy>
          <izz>0.01125</izz>
        </inertia>
      </inertial>

      <sensor name="front_right_ft_sensor" type="force_torque">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <topic>/front_right_motor/force_torque</topic>
        <force_torque>
          <frame>0</frame>
        </force_torque>
      </sensor>

      <collision name="fr_collision">
        <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
        <surface>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
          </bounce>
          <friction><ode><mu1>1.5</mu1><mu2>1.5</mu2></ode></friction>
          <contact>
            <ode>
              <kp>1e7</kp>
              <kd>100</kd>
              <max_vel>0.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="fr_visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="front_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit effort="1000" velocity="1000" />
        <dynamics>
          <damping>0.01</damping>
          <friction>0.000001</friction>
        </dynamics>
      </axis>
    </joint>

    <plugin name="front_right_motor_plugin" filename="libDCMotorPlugin.so">
      <joint_name>front_right_joint</joint_name>
      <resistance>1.0</resistance>
      <torque_constant>0.02</torque_constant>
      <back_emf_constant>0.02</back_emf_constant>
      <gear_ratio>10.0</gear_ratio>
      <voltage_topic>/front_right_motor/voltage</voltage_topic>
      <encoder_topic>/front_right_motor/encoder</encoder_topic>
    </plugin>

    <link name="rear_left_wheel">
      <pose>-0.35 0.2 0.05 -1.5708 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00006583</ixx>
          <iyy>0.00006583</iyy>
          <izz>0.0000125</izz>
        </inertia>
      </inertial>

      <collision name="rl_collision">
        <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
        <surface>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
          </bounce>
          <friction><ode><mu1>0.5</mu1><mu2>0.5</mu2></ode></friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>1</kd>
              <max_vel>0.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="rl_visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rear_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit effort="1000" velocity="1000" />
        <dynamics>
          <damping>0.000005</damping>
          <friction>0.0000001</friction>
        </dynamics>
      </axis>
    </joint>

    <link name="rear_right_wheel">
      <pose>-0.35 -0.2 0.05 -1.5708 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00006583</ixx>
          <iyy>0.00006583</iyy>
          <izz>0.0000125</izz>
        </inertia>
      </inertial>

      <collision name="rr_collision">
        <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
        <surface>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
          </bounce>
          <friction><ode><mu1>0.5</mu1><mu2>0.5</mu2></ode></friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>1</kd>
              <max_vel>0.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="rr_visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rear_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit effort="1000" velocity="1000" />
        <dynamics>
          <damping>0.000005</damping>
          <friction>0.0000001</friction>
        </dynamics>
      </axis>
    </joint>

  </model>
</sdf>